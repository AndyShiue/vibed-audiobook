# Copy this file to ".env" and fill in your key. Never commit the real .env.

# Required for AI answers and memory: a key for the provider you use (see AI_PROVIDER below).
# Claude: https://console.anthropic.com/   ·   OpenAI: https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=

# Optional ---------------------------------------------------------------
# Serve over HTTPS (needed for the microphone on phones). On first start a small personal certificate
# authority is created in .certs/; open http://<this-pc-ip>:3001 on each phone once to install it.
# HTTPS=1

# Cloud speech recognition. Claude cannot take audio as input, so a spoken question is recorded, uploaded to a
# speech-to-text service and the resulting text is answered by Claude. Unlike the phone's built-in recognizer it
# copes with sentences that mix languages (e.g. Chinese with English words). Set ONE of these:
# OPENAI_API_KEY=            # default model: gpt-4o-transcribe (also try TRANSCRIBE_MODEL=gpt-transcribe)
# GROQ_API_KEY=              # default model: whisper-large-v3 (fast and very cheap)
# ...or any OpenAI-compatible server (e.g. a self-hosted Whisper):
# TRANSCRIBE_BASE_URL=http://localhost:8000/v1
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=

# Server voices — an OPTIONAL second voice engine (Settings → Voice engine). The phone's own voices stay the default; with
# this one the server makes the audio and the phone plays it (better voices, and it keeps going when the screen locks).
# The text being read is sent to the service you choose here. Needs no setup for the default, edge:
#   TTS_PROVIDER=edge      Microsoft Edge's read-aloud voices: free, no key, 75 languages. NOT an official API — it can
#                          change or stop working at any time and is not meant for commercial use. Needs Node.js 22+.
#   TTS_PROVIDER=azure     Azure AI Speech (official, free monthly allowance):  AZURE_SPEECH_KEY=...  AZURE_SPEECH_REGION=eastasia
#   TTS_PROVIDER=google    Google Cloud Text-to-Speech (official, free monthly allowance):  GOOGLE_TTS_API_KEY=...
#   TTS_PROVIDER=openai    OpenAI (uses OPENAI_API_KEY; TTS_MODEL defaults to gpt-4o-mini-tts, TTS_VOICE to alloy)
#   TTS_PROVIDER=custom    any OpenAI-compatible /audio/speech server (Kokoro-FastAPI, openedai-speech, ...), so the model is yours:
#                          TTS_BASE_URL=http://localhost:8880/v1   TTS_API_KEY=   TTS_MODEL=   TTS_VOICES=voice1,voice2   TTS_VOICE=voice1
#   TTS_PROVIDER=off       no server voices (the option disappears from Settings)
# TTS_CACHE_MB=64          clips are kept in memory so that listening again costs nothing

# PORT=3000
# HOST=0.0.0.0

# Protects /api/* if you expose the app on the internet (enter the same value in the app's Settings).
# ACCESS_TOKEN=choose-a-long-random-string

# Which company's model does the thinking: anthropic (Claude, the default) or openai.
# Needs ANTHROPIC_API_KEY or OPENAI_API_KEY respectively. To use OpenAI as the main model:
#   AI_PROVIDER=openai
#   OPENAI_API_KEY=...          (the same key also powers cloud speech recognition above)
# Questions and the background notes can use different ones: QA_PROVIDER=... / SUMMARY_PROVIDER=...
# AI_PROVIDER=anthropic

# Model used to answer questions (spoken, so it should be quick) and to write the background
# "story so far" notes (many small calls over a long book — a cheaper model is fine here).
# Defaults: claude-sonnet-5-5 with Claude, gpt-6.1-sol with OpenAI. Cheaper notes, e.g. claude-haiku-4-5 or gpt-5.4-mini.
# QA_MODEL=claude-sonnet-5-5
# SUMMARY_MODEL=claude-sonnet-5-5

# Thinking depth, for either provider (each model accepts its own set; see the README for measured latencies).
#   Claude:  low | medium | high | xhigh | max                       (default low: keeps voice answers snappy)
#   OpenAI:  gpt-6.1-sol takes low | medium | high | xhigh | max (not "none"); gpt-5.5 also takes none | minimal;
#            gpt-4.1 takes nothing (use "off"). Leave it unset and the server tries "low" first and steps down
#            by itself if the model refuses it. A value you set is used exactly as given.
# QA_EFFORT=low
# SUMMARY_EFFORT=low

# Claude only — retry a declined request on another model automatically (server-side fallbacks). "off" disables.
# AI_FALLBACKS=on

# OpenAI only. api.openai.com is used through the Responses API (needed for tools + reasoning on newer models);
# any other OPENAI_BASE_URL (a compatible/self-hosted server) is used through Chat Completions. Force one with:
# OPENAI_API=responses          (or chat)
# OPENAI_BASE_URL=https://api.openai.com/v1
